# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MOJEEB_API_KEY: Server-side secret API key from Mojeeb (requires whatsapp:send scope, e.g. mk_live_...).
# Configure this in Settings -> Secrets. Never expose it to the browser.
MOJEEB_API_KEY="mk_live_JAseVA7GEgWYEs4ORvMOWM_JBWTPR7QFP"

# MOJEEB_AGENT_ID: Optional default Mojeeb Agent UUID (can also be configured in System Settings).
MOJEEB_AGENT_ID="089428a2-ffec-4121-8b63-e9b5bad8b2a1"

# MOJEEB_FROM_PHONE: Optional default E.164 WhatsApp Business sender phone (e.g. +2010xxxxxxxx).
MOJEEB_FROM_PHONE="201011684379"
